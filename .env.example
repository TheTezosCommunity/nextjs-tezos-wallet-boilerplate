# Tezos Network Configuration
# Choose: mainnet, ghostnet, shadownet
NEXT_PUBLIC_TEZOS_NETWORK=ghostnet

# Tezos RPC Endpoints
NEXT_PUBLIC_TEZOS_RPC_MAINNET=https://rpc.tzkt.io/mainnet
NEXT_PUBLIC_TEZOS_RPC_GHOSTNET=https://ghostnet.ecadinfra.com
NEXT_PUBLIC_TEZOS_RPC_SHADOWNET=https://rpc.tzkt.io/shadownet

# TzKT API Endpoints
NEXT_PUBLIC_TZKT_API_MAINNET=https://api.tzkt.io/v1
NEXT_PUBLIC_TZKT_API_GHOSTNET=https://api.ghostnet.tzkt.io/v1
NEXT_PUBLIC_TZKT_API_SHADOWNET=https://api.shadownet.tzkt.io/v1

# TzKT Explorer Endpoints
NEXT_PUBLIC_TZKT_EXPLORER_MAINNET=https://tzkt.io
NEXT_PUBLIC_TZKT_EXPLORER_GHOSTNET=https://ghostnet.tzkt.io
NEXT_PUBLIC_TZKT_EXPLORER_SHADOWNET=https://shadownet.tzkt.io

# DApp Configuration
NEXT_PUBLIC_DAPP_NAME="Tezos Wallet Boilerplate"
NEXT_PUBLIC_DAPP_URL=http://localhost:3000

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
